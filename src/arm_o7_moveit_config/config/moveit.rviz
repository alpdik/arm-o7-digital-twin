Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 0.1
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: /sim
      Planning Group: arm
      Planning Scene Topic: /sim/monitored_planning_scene
      Robot Description: robot_description
      Scene Robot:
        Robot Alpha: 1.0
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trajectory Topic: /sim/display_planned_path
  Global Options:
    Background Color: 48; 52; 58
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.6
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.45
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.35
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.75
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1440
